interface FolderNode {
  id: string;
  name: string;
  count: number;
  owner: string;
  createdAt: string;
  permissions: "private" | "shared" | "public";
  children?: FolderNode[];
  documents?: Document[];
}

interface Document {
  id: number;
  name: string;
  type: string;
  size: string;
  date: string;
  owner: string;
  favorite: boolean;
}

