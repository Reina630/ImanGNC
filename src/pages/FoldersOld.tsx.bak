                              <Share2 className="h-4 w-4 mr-2" /> Partager
                            </DropdownMenuItem>
                          </DropdownMenuContent>
                        </DropdownMenu>
                      </div>
                      <p className="font-medium text-sm truncate mb-1">{doc.name}</p>
                      <div className="flex items-center justify-between text-xs text-muted-foreground">
                        <span>{doc.size}</span>
                        {doc.favorite && <Star className="h-3 w-3 text-warning fill-warning" />}
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div className="space-y-2">
                  {selected.documents.map((doc) => (
                    <div
                      key={doc.id}
                      className="flex items-center gap-3 p-3 rounded-lg hover:bg-muted/30 transition-colors"
                    >
                      <div className="p-2 rounded-lg bg-muted">{getTypeIcon(doc.type)}</div>
                      <div className="flex-1 min-w-0">
                        <p className="font-medium text-sm truncate">{doc.name}</p>
                        <p className="text-xs text-muted-foreground">
                          {doc.type} · {doc.size} · {doc.date}
                        </p>
                      </div>
                      {doc.favorite && <Star className="h-4 w-4 text-warning fill-warning" />}
                      <DropdownMenu>
                        <DropdownMenuTrigger asChild>
                          <button className="p-1 hover:bg-muted rounded transition-colors">
                            <MoreHorizontal className="h-4 w-4" />
                          </button>
                        </DropdownMenuTrigger>
                        <DropdownMenuContent align="end">
                          <DropdownMenuItem>
                            <Eye className="h-4 w-4 mr-2" /> Aperçu
                          </DropdownMenuItem>
                          <DropdownMenuItem>
                            <Download className="h-4 w-4 mr-2" /> Télécharger
                          </DropdownMenuItem>
                          <DropdownMenuItem>
                            <Share2 className="h-4 w-4 mr-2" /> Partager
                          </DropdownMenuItem>
                        </DropdownMenuContent>
                      </DropdownMenu>
                    </div>
                  ))}
                </div>
              )}
            </div>
          )}

          {/* Empty state */}
          {selected && (!selected.children || selected.children.length === 0) && (!selected.documents || selected.documents.length === 0) && (
            <div className="stat-card text-center py-12">
              <FolderOpen className="h-12 w-12 text-muted-foreground mx-auto mb-3" />
              <h3 className="font-semibold text-lg mb-1">Dossier vide</h3>
              <p className="text-sm text-muted-foreground">
                Ce dossier ne contient aucun document ni sous-dossier
              </p>
            </div>
          )}
        </div>
      </div>

      {/* Create Folder Dialog */}
      <Dialog open={createDialog} onOpenChange={setCreateDialog}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle>Créer un nouveau dossier</DialogTitle>
            <DialogDescription>
              Le dossier sera créé dans{" "}
              {selected ? `"${selected.name}"` : "la racine"}
            </DialogDescription>
          </DialogHeader>
          <div className="space-y-4 py-4">
            <div>
              <label className="text-sm font-medium mb-1.5 block">Nom du dossier</label>
              <Input
                placeholder="Ex: Rapports 2024"
                value={newFolderName}
                onChange={(e) => setNewFolderName(e.target.value)}
              />
            </div>
            <div>
              <label className="text-sm font-medium mb-1.5 block">Permissions</label>
              <Select
                value={newFolderPermission}
                onValueChange={(v) => setNewFolderPermission(v as any)}
              >
                <SelectTrigger>
                  <SelectValue />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="private">
                    <div className="flex items-center gap-2">
                      <Lock className="h-4 w-4 text-destructive" />
                      Privé - Visible uniquement par vous
                    </div>
                  </SelectItem>
                  <SelectItem value="shared">
                    <div className="flex items-center gap-2">
                      <Users className="h-4 w-4 text-info" />
                      Partagé - Accessible à certains utilisateurs
                    </div>
                  </SelectItem>
                  <SelectItem value="public">
                    <div className="flex items-center gap-2">
                      <Shield className="h-4 w-4 text-success" />
                      Public - Accessible à tous
                    </div>
                  </SelectItem>
                </SelectContent>
              </Select>
            </div>
          </div>
          <div className="flex justify-end gap-2">
            <Button variant="outline" onClick={() => setCreateDialog(false)}>
              Annuler
            </Button>
            <Button onClick={handleCreateFolder} disabled={!newFolderName.trim()}>
              <FolderPlus className="h-4 w-4 mr-2" />
              Créer
            </Button>
          </div>
        </DialogContent>
      </Dialog>

      {/* Rename Dialog */}
      <Dialog open={!!renameFolder} onOpenChange={() => setRenameFolder(null)}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle>Renommer le dossier</DialogTitle>
            <DialogDescription>
              Modifier le nom de "{renameFolder?.name}"
            </DialogDescription>
          </DialogHeader>
          <div className="py-4">
            <label className="text-sm font-medium mb-1.5 block">Nouveau nom</label>
            <Input
              placeholder="Nouveau nom du dossier"
              defaultValue={renameFolder?.name}
              value={newFolderName}
              onChange={(e) => setNewFolderName(e.target.value)}
            />
          </div>
          <div className="flex justify-end gap-2">
            <Button variant="outline" onClick={() => setRenameFolder(null)}>
              Annuler
            </Button>
            <Button onClick={handleRename} disabled={!newFolderName.trim()}>
              <Pencil className="h-4 w-4 mr-2" />
              Renommer
            </Button>
          </div>
        </DialogContent>
      </Dialog>

      {/* Delete Dialog */}
      <Dialog open={!!deleteFolder} onOpenChange={() => setDeleteFolder(null)}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle>Supprimer le dossier</DialogTitle>
            <DialogDescription>
              Êtes-vous sûr de vouloir supprimer "{deleteFolder?.name}" ?
            </DialogDescription>
          </DialogHeader>
          <div className="py-4">
            <div className="p-4 bg-destructive/10 border border-destructive/20 rounded-lg">
              <p className="text-sm text-destructive font-medium">⚠️ Attention</p>
              <p className="text-sm text-muted-foreground mt-1">
                Cette action supprimera le dossier ainsi que tous ses sous-dossiers et
                documents ({deleteFolder?.count} documents). Cette action est irréversible.
              </p>
            </div>
          </div>
          <div className="flex justify-end gap-2">
            <Button variant="outline" onClick={() => setDeleteFolder(null)}>
              Annuler
            </Button>
            <Button variant="destructive" onClick={handleDelete}>
              <Trash2 className="h-4 w-4 mr-2" />
              Supprimer définitivement
            </Button>
          </div>
        </DialogContent>
      </Dialog>

      {/* Move Dialog */}
      <Dialog open={!!moveFolder} onOpenChange={() => setMoveFolder(null)}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle>Déplacer le dossier</DialogTitle>
            <DialogDescription>
              Sélectionnez la destination pour "{moveFolder?.name}"
            </DialogDescription>
          </DialogHeader>
          <div className="py-4">
            <label className="text-sm font-medium mb-1.5 block">Dossier de destination</label>
            <Select value={targetFolderId} onValueChange={setTargetFolderId}>
              <SelectTrigger>
                <SelectValue placeholder="Choisir un dossier..." />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="root">
                  <div className="flex items-center gap-2">
                    <Home className="h-4 w-4" />
                    Racine
                  </div>
                </SelectItem>
                {allFolders
                  .filter((f) => f.id !== moveFolder?.id)
                  .map((folder) => (
                    <SelectItem key={folder.id} value={folder.id}>
                      <div className="flex items-center gap-2">
                        <FolderClosed className="h-4 w-4" />
                        {folder.name}
                      </div>
                    </SelectItem>
                  ))}
              </SelectContent>
            </Select>
          </div>
          <div className="flex justify-end gap-2">
            <Button variant="outline" onClick={() => setMoveFolder(null)}>
              Annuler
            </Button>
            <Button onClick={handleMove} disabled={!targetFolderId}>
              <Move className="h-4 w-4 mr-2" />
              Déplacer
            </Button>
          </div>
        </DialogContent>
      </Dialog>

      {/* Permissions Dialog */}
      <Dialog open={!!permissionsFolder} onOpenChange={() => setPermissionsFolder(null)}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle>Gérer les permissions</DialogTitle>
            <DialogDescription>
              Modifier les permissions de "{permissionsFolder?.name}"
            </DialogDescription>
          </DialogHeader>
          <div className="space-y-4 py-4">
            <div>
              <label className="text-sm font-medium mb-1.5 block">Niveau d'accès</label>
              <Select
                defaultValue={permissionsFolder?.permissions}
                onValueChange={(v) => setNewFolderPermission(v as any)}
              >
                <SelectTrigger>
                  <SelectValue />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="private">
                    <div className="flex items-center gap-2">
                      <Lock className="h-4 w-4 text-destructive" />
                      <div>
                        <p className="font-medium">Privé</p>
                        <p className="text-xs text-muted-foreground">
                          Visible uniquement par vous
                        </p>
                      </div>
                    </div>
                  </SelectItem>
                  <SelectItem value="shared">
                    <div className="flex items-center gap-2">
                      <Users className="h-4 w-4 text-info" />
                      <div>
                        <p className="font-medium">Partagé</p>
                        <p className="text-xs text-muted-foreground">
                          Accessible à certains utilisateurs
                        </p>
                      </div>
                    </div>
                  </SelectItem>
                  <SelectItem value="public">
                    <div className="flex items-center gap-2">
                      <Shield className="h-4 w-4 text-success" />
                      <div>
                        <p className="font-medium">Public</p>
                        <p className="text-xs text-muted-foreground">Accessible à tous</p>
                      </div>
                    </div>
                  </SelectItem>
                </SelectContent>
              </Select>
            </div>
            {permissionsFolder?.permissions === "shared" && (
              <div className="p-3 bg-muted rounded-lg">
                <p className="text-sm font-medium mb-2">Utilisateurs avec accès</p>
                <div className="space-y-2">
                  {["Marie Kone", "Ahmed Diallo", "Fatou Sow"].map((user) => (
                    <div key={user} className="flex items-center justify-between text-sm">
                      <span>{user}</span>
                      <span className="text-xs text-muted-foreground">Lecture/Écriture</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
          <div className="flex justify-end gap-2">
            <Button variant="outline" onClick={() => setPermissionsFolder(null)}>
              Annuler
            </Button>
            <Button onClick={handlePermissions}>
              <Shield className="h-4 w-4 mr-2" />
              Enregistrer
            </Button>
          </div>
        </DialogContent>
      </Dialog>
    </motion.div>
  );
}
