                      </span>
                      <span className="flex items-center gap-1">
                        <Users className="h-3.5 w-3.5" />
                        {selected.owner}
                      </span>
                      <span className="flex items-center gap-1">
                        {getPermissionIcon(selected.permissions)}
                        {getPermissionText(selected.permissions)}
                      </span>
                    </div>
                  </div>
                </div>
                <DropdownMenu>
                  <DropdownMenuTrigger asChild>
                    <Button variant="outline" size="sm">
                      <MoreHorizontal className="h-4 w-4" />
                    </Button>
                  </DropdownMenuTrigger>
                  <DropdownMenuContent align="end" className="w-44">
                    <DropdownMenuItem onClick={() => setRenameFolder(selected)}>
                      <Pencil className="h-4 w-4 mr-2" /> Renommer
                    </DropdownMenuItem>
                    <DropdownMenuItem onClick={() => setMoveFolder(selected)}>
                      <Move className="h-4 w-4 mr-2" /> Déplacer
                    </DropdownMenuItem>
                    <DropdownMenuItem onClick={() => setPermissionsFolder(selected)}>
                      <Shield className="h-4 w-4 mr-2" /> Permissions
                    </DropdownMenuItem>
                    <DropdownMenuSeparator />
                    <DropdownMenuItem onClick={() => setDeleteFolder(selected)} className="text-destructive">
                      <Trash2 className="h-4 w-4 mr-2" /> Supprimer
                    </DropdownMenuItem>
                  </DropdownMenuContent>
                </DropdownMenu>
              </div>
            </div>
          )}

          {/* Sub-folders */}
          {selected?.children && selected.children.length > 0 && (
            <div className="stat-card">
              <h3 className="font-semibold mb-3">Sous-dossiers</h3>
              <div
                className={
                  view === "grid"
                    ? "grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3"
