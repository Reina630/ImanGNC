function getTypeIcon(type: string) {
  const iconProps = "h-5 w-5";
  switch (type) {
    case "PDF":
      return <FileText className={`${iconProps} text-destructive`} />;
    case "Word":
      return <File className={`${iconProps} text-info`} />;
    case "Excel":
      return <FileSpreadsheet className={`${iconProps} text-success`} />;
    case "Image":
      return <Image className={`${iconProps} text-warning`} />;
    default:
      return <FileText className={`${iconProps} text-muted-foreground`} />;
  }
}

function getPermissionIcon(permission: string) {
  switch (permission) {
    case "private":
      return <Lock className="h-3.5 w-3.5 text-destructive" />;
    case "shared":
      return <Users className="h-3.5 w-3.5 text-info" />;
    case "public":
      return <Shield className="h-3.5 w-3.5 text-success" />;
    default:
      return null;
  }
}

function getPermissionText(permission: string) {
  switch (permission) {
    case "private":
      return "Privé";
    case "shared":
      return "Partagé";
    case "public":
      return "Public";
    default:
      return "";
  }
}

interface FolderItemProps {
  folder: FolderNode;
  level: number;
  expanded: Set<string>;
  selected: string | null;
  onToggle: (id: string) => void;
  onSelect: (folder: FolderNode) => void;
  onRename: (folder: FolderNode) => void;
  onDelete: (folder: FolderNode) => void;
  onMove: (folder: FolderNode) => void;
  onPermissions: (folder: FolderNode) => void;
}

function FolderItem({
  folder,
  level,
  expanded,
  selected,
  onToggle,
  onSelect,
  onRename,
  onDelete,
  onMove,
  onPermissions,
}: FolderItemProps) {
  const isExpanded = expanded.has(folder.id);
  const isSelected = selected === folder.id;
  const hasChildren = folder.children && folder.children.length > 0;

  return (
    <div>
      <div
        className={`flex items-center gap-1.5 p-1.5 rounded-lg cursor-pointer transition-colors group ${
          isSelected ? "bg-primary/10 text-primary" : "hover:bg-muted/50"
        }`}
        style={{ paddingLeft: `${level * 12 + 6}px` }}
      >
        <button
          onClick={() => hasChildren && onToggle(folder.id)}
          className={`p-0.5 hover:bg-muted rounded transition-colors ${
            !hasChildren && "invisible"
          }`}
        >
          {isExpanded ? (
            <ChevronDown className="h-3.5 w-3.5" />
          ) : (
            <ChevronRight className="h-3.5 w-3.5" />
          )}
        </button>

        <div className="flex items-center gap-2 flex-1 min-w-0" onClick={() => onSelect(folder)}>
          {isExpanded ? (
            <FolderOpen className="h-4 w-4 shrink-0" />
          ) : (
            <FolderClosed className="h-4 w-4 shrink-0" />
          )}
          <span className="text-sm font-medium truncate flex-1">{folder.name}</span>
          <span className="text-xs text-muted-foreground shrink-0">({folder.count})</span>
          {getPermissionIcon(folder.permissions)}
        </div>

        <DropdownMenu>
          <DropdownMenuTrigger asChild onClick={(e) => e.stopPropagation()}>
            <button className="p-1 opacity-0 group-hover:opacity-100 hover:bg-muted rounded transition-all">
              <MoreHorizontal className="h-3.5 w-3.5" />
            </button>
          </DropdownMenuTrigger>
          <DropdownMenuContent align="end" className="w-44">
            <DropdownMenuItem onClick={() => onRename(folder)}>
              <Pencil className="h-4 w-4 mr-2" /> Renommer
            </DropdownMenuItem>
            <DropdownMenuItem onClick={() => onMove(folder)}>
              <Move className="h-4 w-4 mr-2" /> Déplacer
            </DropdownMenuItem>
            <DropdownMenuItem onClick={() => onPermissions(folder)}>
              <Shield className="h-4 w-4 mr-2" /> Permissions
            </DropdownMenuItem>
            <DropdownMenuSeparator />
            <DropdownMenuItem onClick={() => onDelete(folder)} className="text-destructive">
              <Trash2 className="h-4 w-4 mr-2" /> Supprimer
            </DropdownMenuItem>
          </DropdownMenuContent>
        </DropdownMenu>
      </div>

      <AnimatePresence>
        {isExpanded && hasChildren && (
          <motion.div
            initial={{ opacity: 0, height: 0 }}
            animate={{ opacity: 1, height: "auto" }}
            exit={{ opacity: 0, height: 0 }}
            transition={{ duration: 0.2 }}
          >
            {folder.children!.map((child) => (
              <FolderItem
                key={child.id}
                folder={child}
                level={level + 1}
                expanded={expanded}
                selected={selected}
                onToggle={onToggle}
                onSelect={onSelect}
                onRename={onRename}
                onDelete={onDelete}
                onMove={onMove}
                onPermissions={onPermissions}
              />
            ))}
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
}

export default function Folders() {
  const [expanded, setExpanded] = useState<Set<string>>(new Set(["1", "2"]));
  const [selected, setSelected] = useState<FolderNode | null>(mockFolderTree[0]);
  const [view, setView] = useState<"grid" | "list">("grid");
  const [searchQuery, setSearchQuery] = useState("");

  // Dialogs state
  const [createDialog, setCreateDialog] = useState(false);
  const [renameFolder, setRenameFolder] = useState<FolderNode | null>(null);
  const [deleteFolder, setDeleteFolder] = useState<FolderNode | null>(null);
  const [moveFolder, setMoveFolder] = useState<FolderNode | null>(null);
  const [permissionsFolder, setPermissionsFolder] = useState<FolderNode | null>(null);

  // Form state
  const [newFolderName, setNewFolderName] = useState("");
  const [newFolderPermission, setNewFolderPermission] = useState<"private" | "shared" | "public">("private");
  const [targetFolderId, setTargetFolderId] = useState<string>("");

  const toggle = (id: string) => {
    const next = new Set(expanded);
    next.has(id) ? next.delete(id) : next.add(id);
    setExpanded(next);
  };

  const buildBreadcrumb = (folder: FolderNode | null): FolderNode[] => {
    if (!folder) return [];
    
    const findPath = (nodes: FolderNode[], targetId: string, path: FolderNode[] = []): FolderNode[] | null => {
      for (const node of nodes) {
        const currentPath = [...path, node];
        if (node.id === targetId) return currentPath;
        if (node.children) {
          const found = findPath(node.children, targetId, currentPath);
          if (found) return found;
        }
      }
      return null;
    };

    return findPath(mockFolderTree, folder.id) || [folder];
  };

  const breadcrumb = buildBreadcrumb(selected);

  const getAllFolders = (nodes: FolderNode[]): FolderNode[] => {
    let result: FolderNode[] = [];
    nodes.forEach((node) => {
      result.push(node);
      if (node.children) {
        result = [...result, ...getAllFolders(node.children)];
      }
    });
    return result;
  };

  const allFolders = getAllFolders(mockFolderTree);

  const handleCreateFolder = () => {
    console.log("Create folder:", newFolderName, "in", selected?.name, "with permission", newFolderPermission);
    setCreateDialog(false);
    setNewFolderName("");
    setNewFolderPermission("private");
  };

  const handleRename = () => {
    console.log("Rename folder:", renameFolder?.name, "to", newFolderName);
    setRenameFolder(null);
    setNewFolderName("");
  };

  const handleDelete = () => {
    console.log("Delete folder:", deleteFolder?.name);
    setDeleteFolder(null);
  };

  const handleMove = () => {
    console.log("Move folder:", moveFolder?.name, "to", targetFolderId);
    setMoveFolder(null);
    setTargetFolderId("");
  };

  const handlePermissions = () => {
    console.log("Update permissions for:", permissionsFolder?.name, "to", newFolderPermission);
    setPermissionsFolder(null);
  };

  return (
    <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} className="space-y-5">
      {/* Header */}
      <div className="flex items-center justify-between flex-wrap gap-3">
        <div>
          <h1 className="text-2xl font-bold flex items-center gap-2">
            <FolderOpen className="h-7 w-7 text-primary" />
            Gestion des dossiers
          </h1>
          <p className="text-muted-foreground text-sm">
            Organisez vos documents en arborescence infinie
          </p>
        </div>
        <Button onClick={() => setCreateDialog(true)}>
          <FolderPlus className="h-4 w-4 mr-2" />
          Nouveau dossier
        </Button>
      </div>

      {/* Stats */}
      <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div className="stat-card">
          <p className="text-sm text-muted-foreground">Total dossiers</p>
          <p className="text-2xl font-bold mt-1">23</p>
        </div>
        <div className="stat-card">
          <p className="text-sm text-muted-foreground">Dossiers partagés</p>
          <p className="text-2xl font-bold mt-1 text-info">12</p>
        </div>
        <div className="stat-card">
          <p className="text-sm text-muted-foreground">Dossiers privés</p>
          <p className="text-2xl font-bold mt-1 text-destructive">8</p>
        </div>
        <div className="stat-card">
          <p className="text-sm text-muted-foreground">Total documents</p>
          <p className="text-2xl font-bold mt-1 text-success">414</p>
        </div>
      </div>

      {/* Main Content */}
      <div className="grid grid-cols-1 lg:grid-cols-4 gap-5">
        {/* Tree Sidebar */}
        <div className="lg:col-span-1">
          <div className="stat-card sticky top-5">
            <div className="flex items-center justify-between mb-3">
              <h3 className="font-semibold">Arborescence</h3>
              <Button variant="ghost" size="sm" onClick={() => setExpanded(new Set())}>
                <X className="h-3.5 w-3.5" />
              </Button>
            </div>
            <div className="space-y-0.5 max-h-[600px] overflow-y-auto pr-2">
              <div
                className={`flex items-center gap-2 p-1.5 rounded-lg cursor-pointer transition-colors ${
                  selected === null ? "bg-primary/10 text-primary" : "hover:bg-muted/50"
                }`}
                onClick={() => setSelected(null)}
              >
                <Home className="h-4 w-4 shrink-0" />
                <span className="text-sm font-medium">Racine</span>
              </div>
              {mockFolderTree.map((folder) => (
                <FolderItem
                  key={folder.id}
                  folder={folder}
                  level={0}
                  expanded={expanded}
                  selected={selected?.id || null}
                  onToggle={toggle}
                  onSelect={setSelected}
                  onRename={setRenameFolder}
                  onDelete={setDeleteFolder}
                  onMove={setMoveFolder}
                  onPermissions={setPermissionsFolder}
                />
              ))}
            </div>
          </div>
        </div>

        {/* Content Area */}
        <div className="lg:col-span-3 space-y-4">
          {/* Breadcrumb & Actions */}
          <div className="stat-card">
            <div className="flex items-center justify-between flex-wrap gap-3">
              <div className="flex items-center gap-2 text-sm flex-wrap">
                <Home className="h-4 w-4 text-muted-foreground" />
                <ChevronRight className="h-3 w-3 text-muted-foreground" />
                {breadcrumb.map((folder, idx) => (
                  <div key={folder.id} className="flex items-center gap-2">
                    <button
                      onClick={() => setSelected(folder)}
                      className="hover:text-primary transition-colors"
